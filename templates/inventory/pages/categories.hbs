<!doctype html>
<html lang="en">
<head>{{> head}}</head>
<body data-page="categories" data-business-name="{{businessName}}" data-app-name="{{appName}}" data-currency="{{currency}}" data-primary-color="{{primaryColor}}" data-business-logo="{{businessLogo}}">
  <div class="app-shell">
    {{> sidebar}}
    <div class="workspace">
      {{> header}}
      <main class="page-content">
        <section class="page-heading">
          <div><p class="eyebrow">ORGANIZATION</p><h1>Categories</h1><p class="page-description">Group products into categories to keep your catalog organized.</p></div>
          <button class="button button-primary" type="button" data-open-category>＋ Add category</button>
        </section>
        <section class="panel table-panel">
          <div class="panel-heading panel-heading-padded"><div><h2>All categories</h2><p id="category-summary">Loading categories…</p></div></div>
          <div class="table-wrap"><table><thead><tr><th>Category</th><th>Description</th><th>Products</th><th>Inventory quantity</th><th><span class="sr-only">Actions</span></th></tr></thead><tbody id="categories-table"><tr><td colspan="5"><div class="loading-state">Loading categories…</div></td></tr></tbody></table></div>
        </section>
      </main>
      {{> footer pageScript="categories"}}
    </div>
  </div>
  {{> modals/category}}
  <div class="sidebar-backdrop" data-sidebar-close></div>
</body>
</html>
