<!doctype html>
<html lang="en">
<head>{{> head}}</head>
<body data-page="stock" data-business-name="{{businessName}}" data-app-name="{{appName}}" data-currency="{{currency}}" data-primary-color="{{primaryColor}}" data-business-logo="{{businessLogo}}">
  <div class="app-shell">
    {{> sidebar}}
    <div class="workspace">
      {{> header}}
      <main class="page-content">
        <section class="page-heading">
          <div><p class="eyebrow">INVENTORY CONTROL</p><h1>Stock movements</h1><p class="page-description">Record receipts, sales, and inventory corrections.</p></div>
          <button class="button button-primary" type="button" data-open-movement>＋ Record movement</button>
        </section>
        <section class="stats-grid stats-grid-compact" aria-label="Stock movement summary">
          <article class="stat-card"><div class="stat-label">Movements this month</div><strong class="stat-value" id="movement-month-count">—</strong><span class="stat-footnote">Stock activity</span></article>
          <article class="stat-card"><div class="stat-label">Units received</div><strong class="stat-value" id="movement-in-count">—</strong><span class="stat-footnote">This month</span></article>
          <article class="stat-card"><div class="stat-label">Units issued</div><strong class="stat-value" id="movement-out-count">—</strong><span class="stat-footnote">This month</span></article>
        </section>
        <section class="panel table-panel">
          <div class="table-toolbar">
            <div class="toolbar-search"><span aria-hidden="true">⌕</span><input id="movement-search" type="search" placeholder="Search products or notes" aria-label="Search stock movements"></div>
            <div class="toolbar-filters"><select id="movement-type-filter" aria-label="Filter by movement type"><option value="">All movement types</option><option value="in">Stock in</option><option value="out">Stock out</option><option value="adjustment">Adjustments</option></select><input id="movement-date-filter" type="month" aria-label="Filter by month"></div>
          </div>
          <div class="table-wrap"><table><thead><tr><th>Date</th><th>Product</th><th>SKU</th><th>Movement</th><th>Quantity change</th><th>Notes</th></tr></thead><tbody id="movements-table"><tr><td colspan="6"><div class="loading-state">Loading movements…</div></td></tr></tbody></table></div>
          <div class="table-footer"><span id="movement-count">Loading…</span><button class="button button-quiet button-small" id="export-movements" type="button">Export CSV</button></div>
        </section>
      </main>
      {{> footer pageScript="stock"}}
    </div>
  </div>
  {{> modals/stock-movement}}
  <div class="sidebar-backdrop" data-sidebar-close></div>
</body>
</html>
