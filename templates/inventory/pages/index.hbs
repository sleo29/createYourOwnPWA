<!doctype html>
<html lang="en">
<head>{{> head}}</head>
<body data-page="index" data-business-name="{{businessName}}" data-app-name="{{appName}}" data-currency="{{currency}}" data-primary-color="{{primaryColor}}" data-business-logo="{{businessLogo}}">
  <div class="app-shell">
    {{> sidebar}}
    <div class="workspace">
      {{> header}}
      <main class="page-content">
        <section class="page-heading">
          <div><p class="eyebrow">OVERVIEW</p><h1>Dashboard</h1><p class="page-description">A clear view of your products, stock levels, and inventory value.</p></div>
          <a class="button button-primary" href="/stock.html">＋ Record stock</a>
        </section>
        <section class="stats-grid" aria-label="Inventory summary">
          <article class="stat-card"><div class="stat-label">Total products <span class="stat-icon">▦</span></div><strong class="stat-value" id="stat-products">—</strong><span class="stat-footnote">Active products</span></article>
          <article class="stat-card"><div class="stat-label">Total stock quantity <span class="stat-icon">⇄</span></div><strong class="stat-value" id="stat-quantity">—</strong><span class="stat-footnote">Units on hand</span></article>
          <article class="stat-card"><div class="stat-label">Low-stock products <span class="stat-icon icon-warning">!</span></div><strong class="stat-value" id="stat-low-stock">—</strong><span class="stat-footnote">At or below minimum</span></article>
          <article class="stat-card"><div class="stat-label">Inventory value <span class="stat-icon">＄</span></div><strong class="stat-value" id="stat-value">—</strong><span class="stat-footnote">At purchase cost</span></article>
        </section>
        <section class="dashboard-grid">
          <article class="panel chart-panel">
            <div class="panel-heading"><div><h2>Inventory snapshot</h2><p>Stock quantity by category</p></div><a class="text-link" href="/reports.html">View reports <span aria-hidden="true">→</span></a></div>
            <div class="chart-wrap"><canvas id="inventory-chart" role="img" aria-label="Inventory quantity by category chart"></canvas><div class="chart-empty empty-state" hidden><span class="empty-icon">◷</span><strong>No inventory to chart yet</strong><span>Add products and stock to see a breakdown.</span></div></div>
          </article>
          <article class="panel movement-panel">
            <div class="panel-heading"><div><h2>Recent movements</h2><p>Your latest stock activity</p></div><a class="text-link" href="/stock.html">See all <span aria-hidden="true">→</span></a></div>
            <div class="movement-list" id="recent-movements"><div class="loading-state">Loading activity…</div></div>
          </article>
        </section>
        <section class="panel low-stock-panel">
          <div class="panel-heading"><div><h2>Needs attention</h2><p>Products at or below their minimum stock level</p></div><a class="text-link" href="/reports.html#low-stock">Low-stock report <span aria-hidden="true">→</span></a></div>
          <div class="table-wrap"><table><thead><tr><th>Product</th><th>SKU</th><th>Category</th><th>In stock</th><th>Minimum</th><th>Status</th></tr></thead><tbody id="dashboard-low-stock"><tr><td colspan="6"><div class="loading-state">Loading inventory…</div></td></tr></tbody></table></div>
        </section>
      </main>
      {{> footer pageScript="dashboard"}}
    </div>
  </div>
  <div class="sidebar-backdrop" data-sidebar-close></div>
</body>
</html>
