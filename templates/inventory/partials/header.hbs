<header class="topbar">
  <button class="icon-button mobile-menu-button" type="button" aria-label="Collapse navigation" aria-controls="app-sidebar" aria-expanded="true" data-sidebar-toggle>
    <span aria-hidden="true">☰</span>
  </button>
  <div class="breadcrumb"><span class="breadcrumb-business">{{businessName}}</span><span aria-hidden="true">/</span><strong id="page-title">Dashboard</strong></div>
  <div class="topbar-actions">
    <form class="global-search" role="search" data-global-search>
      <span aria-hidden="true">⌕</span>
      <input type="search" name="search" placeholder="Search products..." aria-label="Search products">
      <kbd>↵</kbd>
    </form>
    <button class="avatar-button" type="button" aria-label="Business settings" data-settings-link>
      <img class="business-logo" src="{{businessLogo}}" alt="" hidden>
      <span class="business-avatar" aria-hidden="true">B</span>
    </button>
  </div>
</header>
